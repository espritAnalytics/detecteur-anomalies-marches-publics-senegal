# Copier ce fichier en .env et renseigner les valeurs.
# .env est ignoré par git — ne jamais y mettre de vrai mot de passe
# dans un fichier versionné.

PGHOST=localhost
PGPORT=5432
PGDATABASE=marches_publics
PGUSER=postgres
PGPASSWORD=

# Sel de pseudonymisation pour la restitution publique.
# Générer une valeur aléatoire longue, la conserver hors du dépôt,
# et ne jamais la publier.
SEL_PSEUDONYMISATION=
